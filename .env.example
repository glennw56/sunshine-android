# Copy to .env locally if you like; Godot reads OS environment variables
# at runtime. Do not commit secrets. Live AdMob unit IDs stay off-repo.

# Live Square-backed drinks catalog (bakery-drinks Cloud Run).
SUNSHINE_ORDER_URL=https://bakery-drinks-k6uuoen7wa-ue.a.run.app

# mock = in-engine rewarded overlay (default, no Google SDK)
# test = AdMob official test rewarded unit (needs AdMob plugin on device)
# live = your own AdMob unit from env (never commit the unit id)
SUNSHINE_AD_MODE=mock

# Official Google test application id + rewarded unit (safe to commit as defaults).
SUNSHINE_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
SUNSHINE_ADMOB_REWARDED_UNIT=ca-app-pub-3940256099942544/5224354917

# Optional shop-device PIN for the staff board tab. Leave empty to use
# an on-device confirm toggle instead. Do not put production PINs in git.
SUNSHINE_STAFF_PIN=
