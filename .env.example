# Copy to .env locally if you like; Godot reads OS environment variables
# at runtime. Do not commit secrets. AdMob ids below are public (they also
# live in the AndroidManifest) — they are not Play/Square secrets.

# Live Square-backed drinks catalog (bakery-drinks Cloud Run).
SUNSHINE_ORDER_URL=https://bakery-drinks-k6uuoen7wa-ue.a.run.app

# Persistent patio room (sunshine-explore Cloud Run, min 0 / max 1).
SUNSHINE_EXPLORE_URL=https://sunshine-explore-k6uuoen7wa-ue.a.run.app

# mock = in-engine rewarded overlay (editor / no Google SDK)
# test = Google official sample rewarded unit on Android (safe clicks)
# live = production tip_reward (default for Play / 0.1.49+)
SUNSHINE_AD_MODE=live

# Production AdMob (Ronald console). Manifest APPLICATION_ID is this app id.
# For Google sample ads instead: SUNSHINE_AD_MODE=test (rewarded unit swaps at
# runtime; app id in the APK stays production).
SUNSHINE_ADMOB_APP_ID=ca-app-pub-2788636443838183~1520526800
SUNSHINE_ADMOB_REWARDED_UNIT=ca-app-pub-2788636443838183/7894363467
# Google sample (ad_mode=test):
#   ca-app-pub-3940256099942544~3347511713
#   ca-app-pub-3940256099942544/5224354917

# Optional shop-device PIN for the staff board tab. Leave empty to use
# an on-device confirm toggle instead. Do not put production PINs in git.
SUNSHINE_STAFF_PIN=

# Fresh Batch morning hunt (America/Chicago 9:00–11:00).
# auto = shop-local window, force = always on (editor preview), off = disabled.
SUNSHINE_FRESH_BATCH=auto

# Fallback donation goal in cents when Square’s public page has no goal ($500).
# The checkout URL is always https://square.link/u/9tUzPJZQ — do not replace it.
SUNSHINE_DONATE_GOAL_CENTS=50000
