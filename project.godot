; Engine configuration file.
; Sunshine's Bakery FOSS Android app — Godot 4.3+
config_version=5

[application]

config/name="Sunshine's Bakery"
config/description="FOSS Godot 4 app for Sunshine's Bakery (Irondale): live Square-backed ordering, staff-tip rewarded ads, and a walkable low-poly shop."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/branding/sunshine-logo-girl.jpg"

[autoload]

AppConfig="*res://scripts/autoload/app_config.gd"
OrderClient="*res://scripts/autoload/order_client.gd"
NoticeService="*res://scripts/autoload/notice_service.gd"
AdTipService="*res://scripts/autoload/ad_tip_service.gd"
GameSave="*res://scripts/autoload/game_save.gd"

[sunshine]

order_base_url="https://bakery-drinks-k6uuoen7wa-ue.a.run.app"
order_path="/order"
ad_mode="mock"
admob_app_id="ca-app-pub-3940256099942544~3347511713"
admob_rewarded_unit="ca-app-pub-3940256099942544/5224354917"
staff_pin=""
bakery_name="Sunshine's Bakery"
bakery_address="2231 1st Ave S, Irondale AL 35210"
fresh_batch_mode="auto"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

