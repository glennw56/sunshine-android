FROM python:3.12-slim
WORKDIR /app
COPY server/requirements-explore.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY server/explore_sim.py server/explore_app.py /app/
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "uvicorn explore_app:app --host 0.0.0.0 --port ${PORT:-8080}"]
